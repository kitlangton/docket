{
  "name": "@kitlangton/docket",
  "version": "0.1.0",
  "description": "A keyboard-first local review queue for batches of pull requests, with verdicts an agent can act on",
  "keywords": [
    "code-review",
    "pull-requests",
    "git",
    "github",
    "diff",
    "cli",
    "vim",
    "agents",
    "bun"
  ],
  "homepage": "https://github.com/kitlangton/docket#readme",
  "bugs": "https://github.com/kitlangton/docket/issues",
  "repository": "github:kitlangton/docket",
  "license": "MIT",
  "author": "Kit Langton",
  "type": "module",
  "bin": {
    "docket": "./bin/docket.ts"
  },
  "files": [
    "bin",
    "src",
    "web",
    "scripts",
    "examples",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "start": "bun bin/docket.ts",
    "typecheck": "tsc --noEmit && bun scripts/keys.ts --check",
    "keys": "bun scripts/keys.ts",
    "test": "bun test ./test",
    "e2e": "bun test ./e2e"
  },
  "dependencies": {
    "@pierre/diffs": "^1.5.1",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "1.63.0",
    "typescript": "^5.9.0"
  },
  "prettier": {
    "semi": false,
    "printWidth": 140
  }
}
