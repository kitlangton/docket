{
  "name": "docket",
  "version": "0.1.0",
  "description": "Keyboard-first local review docket for a batch of pull requests",
  "license": "MIT",
  "type": "module",
  "bin": {
    "docket": "./bin/docket.ts"
  },
  "scripts": {
    "start": "bun bin/docket.ts",
    "typecheck": "tsc --noEmit && bun scripts/keys.ts --check",
    "keys": "bun scripts/keys.ts"
  },
  "dependencies": {
    "@pierre/diffs": "^1.5.1",
    "geist": "^1.7.2",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.0"
  },
  "prettier": {
    "semi": false,
    "printWidth": 140
  }
}
